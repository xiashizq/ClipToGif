<Window x:Class="ClipToGif.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipToGif.Controls"
        Title="ClipToGif — 视频转 GIF"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_OnDrop"
        DragOver="Window_OnDragOver">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：视频列表 -->
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="视频列表" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="ImportButton" Style="{StaticResource GhostButton}" Content="导入" Click="AddVideos_OnClick" Padding="10,6" Margin="0,0,6,0"/>
                        <Button x:Name="RemoveButton" Style="{StaticResource GhostButton}" Content="移除" Click="RemoveVideo_OnClick" Padding="10,6"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Text="仅链接路径，不会移动或复制视频文件" Margin="0,0,0,10"/>
                <ListBox x:Name="VideoList"
                         ItemsSource="{Binding Videos}"
                         SelectionChanged="VideoList_OnSelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 中间：预览 + 区间 + 参数 -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="预览与区间选取" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlayerTimeText" Style="{StaticResource MutedText}" Text="00:00 / 00:00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource PreviewBgBrush}" CornerRadius="8" ClipToBounds="False">
                    <controls:PreviewPlayer x:Name="Player"
                                            MediaOpened="Player_OnMediaOpened"
                                            MediaEnded="Player_OnMediaEnded"
                                            PositionChanged="Player_OnPositionChanged"
                                            SeekToStartRequested="Player_OnSeekToStartRequested"/>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="StartLabel" Style="{StaticResource MutedText}" Text="起点 00:00"/>
                        <TextBlock x:Name="EndLabel" Style="{StaticResource MutedText}" Text="终点 00:00" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <controls:TimeRangeSlider x:Name="RangeSlider"
                                              HorizontalAlignment="Stretch"
                                              Minimum="0"
                                              Maximum="1"
                                              Start="0"
                                              End="1"
                                              MinimumRange="0.2"
                                              MaximumRange="30"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="DurationStartLabel" Style="{StaticResource MutedText}" Text="00:00"/>
                        <TextBlock x:Name="DurationEndLabel" Style="{StaticResource MutedText}" Text="时长 --:--" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock x:Name="PositionLabel" Style="{StaticResource MutedText}" Text="当前位置 00:00"/>
                        <TextBlock x:Name="SelectionLabel" Style="{StaticResource MutedText}" Text="选区 0.0s" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>

                <Border x:Name="ExportPanel" Grid.Row="3" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="5" Style="{StaticResource SectionTitle}" Text="GIF 导出参数" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource MutedText}" Text="宽度 (px)"/>
                            <TextBox x:Name="WidthBox" Text="480" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource MutedText}" Text="高度 (px，0=按比例)"/>
                            <TextBox x:Name="HeightBox" Text="0" Margin="0,4,0,0" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Style="{StaticResource MutedText}" Text="帧率 FPS"/>
                            <TextBox x:Name="FpsBox" Text="10" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" Text="质量 (1 清晰 → 10 体积小)"/>
                                <TextBlock x:Name="QualityValueText" Style="{StaticResource MutedText}" Text="5" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="QualitySlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="QualitySlider_OnValueChanged" Margin="0,4,0,0"/>
                            <CheckBox x:Name="KeepAspectCheck" Content="保持宽高比（推荐）" IsChecked="True" Margin="0,8,0,0"
                                      Checked="KeepAspectCheck_OnChanged" Unchecked="KeepAspectCheck_OnChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="4" VerticalAlignment="Bottom" Margin="0,12,0,0">
                            <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Content="生成 GIF" Click="GenerateGif_OnClick" Height="36"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Text="就绪"/>
                        <TextBlock x:Name="FfmpegStatusText" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧：GIF 列表 -->
        <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="GIF 列表" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GifCountText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="0 条"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Text="一个视频可生成多条 GIF" Margin="0,0,0,10"/>
                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenGifButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="打开文件" Click="OpenGif_OnClick" HorizontalAlignment="Stretch"/>
                    <Button x:Name="OpenGifFolderButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开目录" Click="OpenGifFolder_OnClick" HorizontalAlignment="Stretch"/>
                    <Button x:Name="DeleteGifButton" Grid.Column="4" Style="{StaticResource GhostButton}" Content="删除" Click="DeleteGif_OnClick" HorizontalAlignment="Stretch"/>
                </Grid>
                <ListBox x:Name="GifList"
                         SelectionChanged="GifList_OnSelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="54" Background="{StaticResource PreviewBgBrush}" CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                        <Run Text="{Binding FileSizeText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
