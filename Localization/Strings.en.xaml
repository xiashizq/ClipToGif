                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="AppTitle">ClipToGif — Video to GIF</sys:String>
    <sys:String x:Key="LanguageLabel">Language</sys:String>
    <sys:String x:Key="LanguageTooltip">Switch language / 切换界面语言</sys:String>
    <sys:String x:Key="VideoListTitle">Videos</sys:String>
    <sys:String x:Key="Import">Import</sys:String>
    <sys:String x:Key="Remove">Remove</sys:String>
    <sys:String x:Key="VideoListHint">Links the file path only. Videos are never copied or moved.</sys:String>
    <sys:String x:Key="PreviewTitle">Preview &amp; range</sys:String>
    <sys:String x:Key="ExportTitle">GIF export</sys:String>
    <sys:String x:Key="WidthLabel">Width (px)</sys:String>
    <sys:String x:Key="HeightLabel">Height (px, 0 = auto)</sys:String>
    <sys:String x:Key="FpsLabel">Frame rate (FPS)</sys:String>
    <sys:String x:Key="QualityLabel">Quality (1 sharp → 10 smaller)</sys:String>
    <sys:String x:Key="CompressionLabel">Compression</sys:String>
    <sys:String x:Key="CompressionNone">None</sys:String>
    <sys:String x:Key="CompressionNoneTip">No extra compression. Encode with the current quality settings.</sys:String>
    <sys:String x:Key="CompressionLosslessTransdiff">Lossless · Transparency diff</sys:String>
    <sys:String x:Key="CompressionLosslessTransdiffTip">Store only pixels that changed from the previous frame. Same image, usually a smaller file.</sys:String>
    <sys:String x:Key="CompressionLosslessRectangle">Lossless · Rectangle update</sys:String>
    <sys:String x:Key="CompressionLosslessRectangleTip">Redraw only the changed region. Works well when motion is localized.</sys:String>
    <sys:String x:Key="CompressionLosslessPaletteDiff">Lossless · Palette diff</sys:String>
    <sys:String x:Key="CompressionLosslessPaletteDiffTip">Build the palette from frame differences and apply transparency/rectangle packing. Often the smallest lossless option.</sys:String>
    <sys:String x:Key="CompressionLossyBayer">Lossy · Bayer dither</sys:String>
    <sys:String x:Key="CompressionLossyBayerTip">Reduce colors with Bayer dithering. Smaller files; may show a regular pattern.</sys:String>
    <sys:String x:Key="CompressionLossyFloyd">Lossy · Error diffusion</sys:String>
    <sys:String x:Key="CompressionLossyFloydTip">Reduce colors with Floyd–Steinberg dithering. Smoother gradients; size between Bayer and strong.</sys:String>
    <sys:String x:Key="CompressionLossyStrong">Lossy · Strong</sys:String>
    <sys:String x:Key="CompressionLossyStrongTip">Aggressive color reduction and similar-frame merging. Smallest files, most quality loss.</sys:String>
    <sys:String x:Key="ScaleLabel">Scale</sys:String>
    <sys:String x:Key="Scale100">100% · Original</sys:String>
    <sys:String x:Key="Scale75">Scale to 75%</sys:String>
    <sys:String x:Key="Scale50">Scale to 50%</sys:String>
    <sys:String x:Key="Scale25">Scale to 25%</sys:String>
