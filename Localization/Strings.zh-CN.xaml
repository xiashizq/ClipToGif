    <sys:String x:Key="FitStillLarge">已尽量压缩，仍有 {0}，超过 {1}。可再降低宽度或缩短选区。</sys:String>
    <sys:String x:Key="KeepAspect">保持宽高比（推荐）</sys:String>
    <sys:String x:Key="CropHint">拖动画面可裁切</sys:String>
    <sys:String x:Key="CropReset">重置裁切</sys:String>
    <sys:String x:Key="CropSize">裁切 {0}×{1}</sys:String>
    <sys:String x:Key="GenerateGif">生成 GIF</sys:String>
    <sys:String x:Key="CancelGenerate">取消生成</sys:String>
    <sys:String x:Key="CancellingGenerate">正在取消…</sys:String>
    <sys:String x:Key="Ready">就绪</sys:String>
    <sys:String x:Key="GifListTitle">GIF 列表</sys:String>
    <sys:String x:Key="GifListHint">一个视频可生成多条 GIF</sys:String>
