<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="AppTitle">ClipToGif — 视频转 GIF</sys:String>
    <sys:String x:Key="LanguageLabel">语言</sys:String>
    <sys:String x:Key="LanguageTooltip">切换界面语言 / Switch language</sys:String>
    <sys:String x:Key="VideoListTitle">视频列表</sys:String>
    <sys:String x:Key="Import">导入</sys:String>
    <sys:String x:Key="Remove">移除</sys:String>
    <sys:String x:Key="VideoListHint">仅链接路径，不会移动或复制视频文件</sys:String>
    <sys:String x:Key="PreviewTitle">预览与区间选取</sys:String>
    <sys:String x:Key="ExportTitle">GIF 导出参数</sys:String>
    <sys:String x:Key="WidthLabel">宽度 (px)</sys:String>
    <sys:String x:Key="HeightLabel">高度 (px，0=按比例)</sys:String>
    <sys:String x:Key="FpsLabel">帧率 FPS</sys:String>
    <sys:String x:Key="QualityLabel">质量 (1 清晰 → 10 体积小)</sys:String>
    <sys:String x:Key="CompressionLabel">压缩算法</sys:String>
    <sys:String x:Key="CompressionNone">不压缩</sys:String>
    <sys:String x:Key="CompressionNoneTip">不做额外压缩，按当前质量参数直接生成 GIF。</sys:String>
    <sys:String x:Key="CompressionLosslessTransdiff">无损 · 透明差分</sys:String>
    <sys:String x:Key="CompressionLosslessTransdiffTip">仅编码相对上一帧变化的像素，画面不变，体积通常更小。</sys:String>
    <sys:String x:Key="CompressionLosslessRectangle">无损 · 矩形更新</sys:String>
    <sys:String x:Key="CompressionLosslessRectangleTip">只重绘变化区域，适合局部运动的画面。</sys:String>
    <sys:String x:Key="CompressionLosslessPaletteDiff">无损 · 调色板差分</sys:String>
    <sys:String x:Key="CompressionLosslessPaletteDiffTip">按帧差生成调色板并做透明/矩形优化，无损里体积通常最小。</sys:String>
    <sys:String x:Key="CompressionLossyBayer">有损 · Bayer 抖动</sys:String>
    <sys:String x:Key="CompressionLossyBayerTip">用 Bayer 抖动减色，体积更小，可能出现规则纹理。</sys:String>
    <sys:String x:Key="CompressionLossyFloyd">有损 · 误差扩散</sys:String>
    <sys:String x:Key="CompressionLossyFloydTip">用 Floyd–Steinberg 误差扩散减色，过渡更自然，体积介于 Bayer 与强力之间。</sys:String>
    <sys:String x:Key="CompressionLossyStrong">有损 · 强力压缩</sys:String>
    <sys:String x:Key="CompressionLossyStrongTip">大幅减色、合并相似帧，体积最小，画质下降最明显。</sys:String>
    <sys:String x:Key="ScaleLabel">按比例缩小</sys:String>
    <sys:String x:Key="Scale100">100% · 原始尺寸</sys:String>
    <sys:String x:Key="Scale75">缩小到 75%</sys:String>
    <sys:String x:Key="Scale50">缩小到 50%</sys:String>
    <sys:String x:Key="Scale25">缩小到 25%</sys:String>
    <sys:String x:Key="ScaleCustom">自定义</sys:String>
    <sys:String x:Key="ScaleCustomPercent">自定义 {0}%</sys:String>
    <sys:String x:Key="ScaleCustomTitle">自定义缩放</sys:String>
    <sys:String x:Key="ScaleCustomPrompt">缩放比例（%）</sys:String>
    <sys:String x:Key="ScaleCustomHint">请输入 1–99 的整数（最多两位）。</sys:String>
    <sys:String x:Key="ScaleCustomInvalid">请输入 1–99 的整数。</sys:String>
    <sys:String x:Key="DialogOk">确定</sys:String>
    <sys:String x:Key="DialogCancel">取消</sys:String>
    <sys:String x:Key="SizeLimitLabel">体积上限</sys:String>
    <sys:String x:Key="SizeLimitNone">不限制</sys:String>
    <sys:String x:Key="SizeLimitNoneTip">按当前宽高、帧率和质量直接导出。</sys:String>
    <sys:String x:Key="SizeLimitWechat">公众号 ≤ 10MB</sys:String>
    <sys:String x:Key="SizeLimitWechatTip">超出时按实际体积微调分辨率，尽量贴近 10MB；只有仍然超限才会降低帧率或压缩。公众号正文大约 900px 宽。</sys:String>
    <sys:String x:Key="FittingGifStart">正在生成，目标 ≤ {0}…</sys:String>
    <sys:String x:Key="FittingGifRetry">超出上限，正在缩小重试（第 {1} 次，目标 ≤ {0}）…</sys:String>
