<UserControl x:Class="ClipToGif.Controls.PreviewPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             xmlns:controls="clr-namespace:ClipToGif.Controls"
             Background="#111318"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="VolumeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#44FFFFFF" VerticalAlignment="Center" Margin="6,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#0F766E" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="VideoHost" Grid.Row="0">
            <ffme:MediaElement x:Name="Media"
                               Background="#111318"
                               Stretch="Uniform"
                               LoadedBehavior="Pause"
                               UnloadedBehavior="Manual"
                               ScrubbingEnabled="True"
                               Volume="0.8"
                               MediaOpening="Media_OnMediaOpening"
                               MediaOpened="Media_OnMediaOpened"
                               MediaFailed="Media_OnMediaFailed"
                               MediaEnded="Media_OnMediaEnded"
                               PositionChanged="Media_OnPositionChanged"
                               MediaStateChanged="Media_OnMediaStateChanged"/>
            <controls:CropOverlay x:Name="CropLayer"
                                  Visibility="Collapsed"
                                  CropChanged="CropLayer_OnCropChanged"/>
        </Grid>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="0"
                   Text="{DynamicResource EmptyHint}"
                   Foreground="#9AA3AF"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>

        <Border x:Name="MissingOverlay"
                Grid.Row="0"
                Background="#CC111318"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock x:Name="MissingTitle"
                           Text="{DynamicResource VideoMissing}"
                           Foreground="#FF8A80"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="MissingPathText"
                           Margin="0,12,0,0"
                           Foreground="#B0B8C4"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="420"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1A1E26" Padding="10,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayPauseButton" Style="{StaticResource VolumeButton}" Content="{DynamicResource Play}"
                            Click="PlayPauseButton_OnClick" Padding="10,4" IsEnabled="False"/>
                    <Button x:Name="SeekStartButton" Style="{StaticResource VolumeButton}" Content="{DynamicResource SeekToStart}"
                            Click="SeekStartButton_OnClick" Padding="10,4" Margin="4,0,0,0" IsEnabled="False"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="VolumeLabel" Text="{DynamicResource Volume}" Foreground="#C9D0D8" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="MuteButton" Style="{StaticResource VolumeButton}" Content="{DynamicResource Mute}"
                            Click="MuteButton_OnClick" Margin="8,0,0,0" IsEnabled="False"/>
                    <Slider x:Name="VolumeSlider"
                            Style="{StaticResource VolumeSliderStyle}"
                            Width="120"
                            Value="0.8"
                            Margin="8,0,8,0"
                            IsEnabled="False"
                            ValueChanged="VolumeSlider_OnValueChanged"/>
                    <TextBlock x:Name="VolumeText" Text="80%" Foreground="#C9D0D8" FontSize="12" VerticalAlignment="Center" Width="36"/>
                </StackPanel>
                <DockPanel LastChildFill="True" Margin="12,0" VerticalAlignment="Center">
                    <Button x:Name="ResetCropButton" DockPanel.Dock="Right" Style="{StaticResource VolumeButton}"
                            Content="{DynamicResource CropReset}"
                            Click="ResetCropButton_OnClick" Padding="10,4" Margin="8,0,0,0"
                            Visibility="Collapsed" IsEnabled="False"/>
                    <TextBlock x:Name="CropSizeText" Foreground="#C9D0D8" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="{DynamicResource CropHint}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
