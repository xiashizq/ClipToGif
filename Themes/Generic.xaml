<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ClipToGif.Controls">
    <Style x:Key="TimelineScrollRepeatButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TimelinePanScrollBar" TargetType="ScrollBar">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Margin" Value="4,10,4,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent"
                          ClipToBounds="False"
                          SnapsToDevicePixels="False"
                          UseLayoutRounding="True">
                        <Border Height="6"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Background="#DCE3EA"
                                CornerRadius="3"/>
                        <Track x:Name="PART_Track"
                               Margin="8,0"
                               Orientation="Horizontal"
                               IsDirectionReversed="False"
                               ClipToBounds="False"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TimelineScrollRepeatButton}"
                                              Command="{x:Static ScrollBar.PageLeftCommand}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinWidth="48"
                                       Cursor="SizeWE"
                                       ClipToBounds="False"
                                       SnapsToDevicePixels="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" ClipToBounds="False">
                                                <Border x:Name="ThumbBody"
                                                        Height="14"
                                                        VerticalAlignment="Center"
                                                        Background="#64748B"
                                                        CornerRadius="7"
                                                        Opacity="0.78">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <Ellipse Width="2" Height="2" Fill="#E2E8F0"/>
                                                        <Ellipse Width="2" Height="2" Fill="#E2E8F0" Margin="3,0"/>
                                                        <Ellipse Width="2" Height="2" Fill="#E2E8F0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#0F766E"/>
                                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#0F766E"/>
                                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TimelineScrollRepeatButton}"
                                              Command="{x:Static ScrollBar.PageRightCommand}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TimeRangeSlider}">
        <Setter Property="MinHeight" Value="78"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimeRangeSlider}">
                    <Grid HorizontalAlignment="Stretch" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.RowSpan="2"
                                Background="#17202C"
                                BorderBrush="#263446"
                                BorderThickness="1"
                                CornerRadius="8"/>

                        <Canvas x:Name="PART_RulerCanvas"
                                Grid.Row="0"
                                Margin="1,1,1,0"
                                ClipToBounds="True"
                                IsHitTestVisible="False"/>

                        <Canvas x:Name="PART_TrackCanvas"
                                Grid.Row="1"
                                Margin="1,0,1,1"
                                ClipToBounds="True"
                                HorizontalAlignment="Stretch">
                            <Border Height="32"
                                    Background="#222E3D"
                                    BorderBrush="#304157"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Canvas.Left="8"
                                    Canvas.Top="5"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <!-- 点击轨道跳转播放位置 -->
                            <Border x:Name="PART_TrackHit"
                                    Height="46"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <Border x:Name="PART_Selection"
                                    Height="32"
                                    CornerRadius="5"
                                    BorderBrush="#2DD4BF"
                                    BorderThickness="1"
                                    Opacity="0.92"
                                    IsHitTestVisible="False"
                                    Canvas.Top="5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#178A80" Offset="0"/>
                                        <GradientStop Color="#0F675F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border x:Name="PART_RangeHit"
                                    Height="32"
                                    Background="#01000000"
                                    Cursor="SizeAll"
                                    ToolTip="{DynamicResource RangeDragTooltip}"
                                    Canvas.Top="5"
                                    Panel.ZIndex="1"/>

                            <Thumb x:Name="PART_StartThumb" Width="12" Height="38" Canvas.Top="2" Cursor="SizeWE" Panel.ZIndex="2">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Border Background="#F8FAFC" BorderBrush="#2DD4BF" BorderThickness="2" CornerRadius="3"/>
                                            <Rectangle Width="2" Height="14" Fill="#0F766E" RadiusX="1" RadiusY="1"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                            <Thumb x:Name="PART_EndThumb" Width="12" Height="38" Canvas.Top="2" Cursor="SizeWE" Panel.ZIndex="2">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Border Background="#F8FAFC" BorderBrush="#2DD4BF" BorderThickness="2" CornerRadius="3"/>
                                            <Rectangle Width="2" Height="14" Fill="#0F766E" RadiusX="1" RadiusY="1"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                            <!-- 可拖动播放光标 -->
                            <Thumb x:Name="PART_PlayheadThumb" Width="16" Height="50" Canvas.Top="0" Cursor="Hand" Panel.ZIndex="3">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Rectangle Width="2" Height="44" Fill="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            <Path Data="M 2,1 L 14,1 L 14,8 L 8,13 L 2,8 Z"
                                                  Fill="#F59E0B"
                                                  Stroke="#FFF7ED"
                                                  StrokeThickness="1"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Canvas>

                        <ScrollBar x:Name="PART_HorizontalScroll"
                                   Grid.Row="2"
                                   Panel.ZIndex="10"
                                   Orientation="Horizontal"
                                   Style="{StaticResource TimelinePanScrollBar}"
                                   ToolTip="{DynamicResource TimelinePanTooltip}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
