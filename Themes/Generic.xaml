<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ClipToGif.Controls">
    <Style TargetType="{x:Type controls:TimeRangeSlider}">
        <Setter Property="Height" Value="52"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimeRangeSlider}">
                    <Grid Margin="0,8" HorizontalAlignment="Stretch">
                        <Border Height="8"
                                CornerRadius="4"
                                Background="#C9D0D8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Margin="8,0"/>
                        <Canvas x:Name="PART_TrackCanvas"
                                ClipToBounds="False"
                                HorizontalAlignment="Stretch">
                            <!-- 点击轨道跳转播放位置 -->
                            <Border x:Name="PART_TrackHit"
                                    Height="28"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Canvas.Left="0"
                                    Canvas.Top="10"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="PART_Selection"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="#0F766E"
                                    Opacity="0.85"
                                    IsHitTestVisible="False"
                                    Canvas.Top="20"/>
                            <Border x:Name="PART_RangeHit"
                                    Height="28"
                                    Background="#01000000"
                                    Cursor="SizeAll"
                                    ToolTip="{DynamicResource RangeDragTooltip}"
                                    Canvas.Top="10"
                                    Panel.ZIndex="1"/>
                            <Thumb x:Name="PART_StartThumb" Width="12" Height="28" Canvas.Top="10" Cursor="SizeWE" Panel.ZIndex="2">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#FFFFFF" BorderBrush="#0F766E" BorderThickness="2" CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_EndThumb" Width="12" Height="28" Canvas.Top="10" Cursor="SizeWE" Panel.ZIndex="2">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#FFFFFF" BorderBrush="#0F766E" BorderThickness="2" CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <!-- 可拖动播放光标 -->
                            <Thumb x:Name="PART_PlayheadThumb" Width="14" Height="36" Canvas.Top="6" Cursor="Hand" Panel.ZIndex="3">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Rectangle Width="3" Height="36" Fill="#D97706" HorizontalAlignment="Center"/>
                                            <Ellipse Width="12" Height="12" Fill="#D97706" Stroke="#FFFFFF" StrokeThickness="2"
                                                     VerticalAlignment="Top" Margin="0,0,0,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
