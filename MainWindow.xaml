<Window x:Class="ClipToGif.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipToGif.Controls"
        Title="{DynamicResource AppTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="900" Width="1400"
        MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_OnDrop"
        DragOver="Window_OnDragOver"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="292"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：视频列表 -->
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource VideoListTitle}" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="ImportButton" Style="{StaticResource GhostButton}" Content="{DynamicResource Import}" Click="AddVideos_OnClick" Padding="10,6" Margin="0,0,6,0"/>
                        <Button x:Name="RemoveButton" Style="{StaticResource GhostButton}" Content="{DynamicResource Remove}" Click="RemoveVideo_OnClick" Padding="10,6"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Text="{DynamicResource VideoListHint}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <ListBox x:Name="VideoList"
                         ItemsSource="{Binding Videos}"
                         SelectionChanged="VideoList_OnSelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 中间：预览 + 区间 + 参数 -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <ScrollViewer x:Name="WorkspaceScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Focusable="False">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=WorkspaceScrollViewer}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource PreviewTitle}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrushKey}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                ToolTip="{DynamicResource LanguageTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"/>
                                    <Ellipse Width="6.5" HorizontalAlignment="Center" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.2"/>
                                    <Path Data="M 1.5,8 H 14.5" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.2" Stretch="None"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource LanguageLabel}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Border Background="White" CornerRadius="6" Padding="2" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="LangZhButton" Style="{StaticResource LanguageChip}" Content="中文" Click="LangZh_OnClick"/>
                                        <Button x:Name="LangEnButton" Style="{StaticResource LanguageChip}" Content="EN" Click="LangEn_OnClick" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PlayerTimeText" Style="{StaticResource MutedText}" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource PreviewBgBrush}" CornerRadius="12" ClipToBounds="False">
                    <controls:PreviewPlayer x:Name="Player"
                                            MediaOpened="Player_OnMediaOpened"
                                            MediaEnded="Player_OnMediaEnded"
                                            PositionChanged="Player_OnPositionChanged"
                                            SeekToStartRequested="Player_OnSeekToStartRequested"
                                            CropChanged="Player_OnCropChanged"/>
                </Border>

                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrushKey}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,8"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,7">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="16" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource TimelineTitle}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TimelineZoomHint}"
                                           Style="{StaticResource MutedText}"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource TimelineZoom}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <Button Style="{StaticResource TimelineToolButton}"
                                        Content="−"
                                        Click="TimelineZoomOut_OnClick"
                                        ToolTip="{DynamicResource TimelineZoomOutTooltip}"/>
                                <Slider x:Name="TimelineZoomSlider"
                                        Minimum="1"
                                        Maximum="32"
                                        Value="{Binding ZoomLevel, ElementName=RangeSlider, Mode=TwoWay}"
                                        ValueChanged="TimelineZoomSlider_OnValueChanged"
                                        IsMoveToPointEnabled="True"
                                        Width="104"
                                        Margin="7,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource TimelineZoomTooltip}"/>
                                <Button Style="{StaticResource TimelineToolButton}"
                                        Content="+"
                                        Click="TimelineZoomIn_OnClick"
                                        ToolTip="{DynamicResource TimelineZoomInTooltip}"/>
                                <TextBlock x:Name="ZoomValueText"
                                           Text="100%"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Width="40"
                                           Margin="7,0,0,0"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TimelineFitButton}"
                                        Content="{DynamicResource TimelineFit}"
                                        Click="TimelineFit_OnClick"
                                        ToolTip="{DynamicResource TimelineFitTooltip}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <controls:TimeRangeSlider x:Name="RangeSlider"
                                                  Grid.Row="1"
                                                  HorizontalAlignment="Stretch"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Start="0"
                                                  End="1"
                                                  MinimumRange="0.2"
                                                  MaximumRange="0"/>

                        <Grid Grid.Row="2" Margin="2,6,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock x:Name="DurationStartLabel" Style="{StaticResource MutedText}" Text="00:00"/>
                                <TextBlock Text="  /  " Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="DurationEndLabel" Style="{StaticResource MutedText}" Text="时长 --:--"/>
                            </StackPanel>
                            <TextBlock x:Name="StartLabel" Grid.Column="1" Style="{StaticResource TimelineMetricText}" Text="起点 00:00"/>
                            <TextBlock x:Name="EndLabel" Grid.Column="3" Style="{StaticResource TimelineMetricText}" Text="终点 00:00"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <TextBlock x:Name="PositionLabel" Style="{StaticResource TimelineMetricText}" Text="当前位置 00:00"/>
                                <TextBlock Text="  ·  " Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="SelectionLabel" Style="{StaticResource TimelineMetricText}" Text="选区 0.0s"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ExportPanel" Grid.Row="3" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="5" Style="{StaticResource SectionTitle}" Text="{DynamicResource ExportTitle}" Margin="0,0,0,8"/>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource WidthLabel}"/>
                            <TextBox x:Name="WidthBox" Text="480" Margin="0,4,0,0" TextChanged="WidthBox_OnTextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource HeightLabel}"/>
                            <TextBox x:Name="HeightBox" Text="0" Margin="0,4,0,0" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource FpsLabel}"/>
                            <TextBox x:Name="FpsBox" Text="10" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource CompressionLabel}"/>
                            <ComboBox x:Name="CompressionBox"
                                      Margin="0,4,0,0"
                                      SelectedValuePath="Mode"
                                      SelectionChanged="CompressionBox_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource ScaleLabel}"/>
                            <ComboBox x:Name="ScaleBox"
                                      Margin="0,4,0,0"
                                      SelectedValuePath="Id"
                                      SelectionChanged="ScaleBox_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource QualityLabel}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="QualityValueText" Style="{StaticResource MutedText}" Text="5" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="QualitySlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="QualitySlider_OnValueChanged" Margin="0,4,0,0"/>
                            <CheckBox x:Name="KeepAspectCheck" Content="{DynamicResource KeepAspect}" IsChecked="True" Margin="0,8,0,0"
                                      Checked="KeepAspectCheck_OnChanged" Unchecked="KeepAspectCheck_OnChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="4" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource SizeLimitLabel}"/>
                            <ComboBox x:Name="SizeLimitBox"
                                      Margin="0,4,0,8"
                                      SelectedValuePath="Id"
                                      SelectionChanged="SizeLimitBox_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Height="36">
                                <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource GenerateGif}" Click="GenerateGif_OnClick"/>
                                <Button x:Name="CancelGenerateButton" Style="{StaticResource DangerGhostButton}" Content="{DynamicResource CancelGenerate}" Click="CancelGenerate_OnClick" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource MutedText}"
                                   Text="{DynamicResource Ready}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock x:Name="FfmpegStatusText"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ProgressValueText"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="0%"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- 右侧：GIF 列表 -->
        <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource GifListTitle}" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GifCountText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="0"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Text="{DynamicResource GifListHint}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenGifButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="{DynamicResource OpenFile}" Click="OpenGif_OnClick" HorizontalAlignment="Stretch"/>
                    <Button x:Name="OpenGifFolderButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="{DynamicResource OpenFolder}" Click="OpenGifFolder_OnClick" HorizontalAlignment="Stretch"/>
                    <Button x:Name="DeleteGifButton" Grid.Column="4" Style="{StaticResource GhostButton}" Content="{DynamicResource Delete}" Click="DeleteGif_OnClick" HorizontalAlignment="Stretch"/>
                </Grid>
                <ListBox x:Name="GifList"
                         SelectionChanged="GifList_OnSelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="54" Background="{StaticResource PreviewBgBrush}" CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                        <Run Text="{Binding FileSizeText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
